# SERVER ENVIRONMENT
PORT=3000
NODE_ENV=production

# GEMINI_API_KEY: Required for Gemini AI API calls (Retenção Pro, análise preditiva de satisfação, escuta multimodal de áudios de WhatsApp, boletins inteligentes e assistente da oficina)
# Chave da API do Google Gemini (mantida exclusivamente no backend, NUNCA exposta ao cliente no frontend)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Domínio oficial da plataforma (https://bomprojeto.com)
# Usada para gerar links de acompanhamento do cliente sem senha enviados no WhatsApp
APP_URL="https://bomprojeto.com"

# UAZAPI WhatsApp Integration (https://docs.uazapi.com/)
# UAZAPI_BASE_URL: The base URL of your UAZAPI instance/server (e.g. https://api.uazapi.com or your custom domain)
UAZAPI_BASE_URL="https://api.uazapi.com"

# UAZAPI_TOKEN: The instance token / API key provided in your UAZAPI dashboard
UAZAPI_TOKEN=""

# UAZAPI_INSTANCE_NAME: The session/instance name configured in UAZAPI (e.g. marcenaria-ferraz)
UAZAPI_INSTANCE_NAME="marcenaria-ferraz"

# UAZAPI_ADMIN_TOKEN: (Optional) Admin token if managing instances via API
UAZAPI_ADMIN_TOKEN=""

# PAYMENT GATEWAY & BILLING INTEGRATION (Mercado Pago / Asaas / Gateway Seguro)
# PAYMENT_GATEWAY_ENV: 'sandbox' para homologação/testes ou 'production' para cobrança real
PAYMENT_GATEWAY_ENV="sandbox"

# PAYMENT_PUBLIC_KEY: Usada exclusivamente no front-end para renderizar elementos seguros ou tokenizar cartão (ex: pk_test_...)
PAYMENT_PUBLIC_KEY="pk_test_..."

# PAYMENT_SECRET_KEY / MERCADO_PAGO_ACCESS_TOKEN: Usada exclusivamente no back-end para criar cobranças, Pix e planos (NUNCA expor no front-end)
PAYMENT_SECRET_KEY="sk_test_..."
MERCADO_PAGO_ACCESS_TOKEN=""

# PAYMENT_WEBHOOK_SECRET: Chave secreta para validação criptográfica (HMAC-SHA256) das notificações de pagamento
PAYMENT_WEBHOOK_SECRET="whsec_..."

# SUPABASE CONFIGURATION (Banco de dados principal e autenticação)
# VITE_SUPABASE_URL: URL do seu projeto Supabase (ex: https://qcdonlhdjxoxxfwwvoxj.supabase.co)
VITE_SUPABASE_URL="https://qcdonlhdjxoxxfwwvoxj.supabase.co"
# VITE_SUPABASE_ANON_KEY: Chave pública/anon do Supabase
VITE_SUPABASE_ANON_KEY="sb_publishable_08OVnUDyzigJnsSUJ6eBPA_L6fzlu1y"

